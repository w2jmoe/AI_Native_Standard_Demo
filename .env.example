# Copy to .env.local and fill in your credentials.
# Use the SAME variable names on Vercel.
# Never commit .env.local.
#
# Do NOT swap these values:
#   API_KEY  = Bearer token starting with sk-
#   BASE_URL = https://api.302ai.cn/v1  (China) or https://api.302.ai/v1 (intl)
#   MODEL    = gpt-5-mini

API_KEY=
BASE_URL=https://api.302ai.cn/v1
MODEL=gpt-5-mini

# Supabase (anonymous assessment research storage)
# Create table with: supabase/assessments.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=
