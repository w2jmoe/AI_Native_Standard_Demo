# Copy to .env.local and fill in your credentials.
# Never commit .env.local.
#
# Do NOT swap these values:
#   302_API_KEY  = Bearer token starting with sk-
#   302_BASE_URL = https://api.302ai.cn/v1  (China) or https://api.302.ai/v1 (intl)

302_API_KEY=
302_BASE_URL=https://api.302ai.cn/v1
302_MODEL=gpt-5-mini

# Supabase (anonymous assessment research storage)
# Create table with: supabase/assessments.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=
